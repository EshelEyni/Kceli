{
  "name": "kceli",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "deploy:watch": "gh run watch --repo EshelEyni/Kceli",
    "deploy:kceli": "gh workflow run deploy-kceli.yml --repo EshelEyni/Kceli --ref main",
    "docker:publish": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy/publish-image.ps1",
    "deploy:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy/publish-and-deploy.ps1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
