{
  "schemaVersion": "2.2",
  "description": "Redeploy only the configured Kceli container using a protected server script.",
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "redeployKceli",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "exec /usr/local/sbin/kceli-redeploy"
        ]
      }
    }
  ]
}
